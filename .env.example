# ═══════════════════════════════════════════════════════════════════════
# HealthGuard configuration — copy to `.env` and fill in the secrets.
# Every setting has a sensible default; see backend/core/config.py.
# ═══════════════════════════════════════════════════════════════════════

ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:8501

# ── Infrastructure ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://healthguard:healthguard@localhost:5432/healthguard
# POSTGRES_HOST_PORT=5433         # host port for the compose postgres (default 5432); match DATABASE_URL
REDIS_URL=redis://localhost:6379/0   # must be db 0: Redis search indexes (semantic cache) only exist on db 0
AGENT_DB_USER=hg_agent_ro
AGENT_DB_PASSWORD=change-me-agent-ro

# ── Auth ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-32+chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
DEMO_PASSWORD=HealthGuard!2026   # password for the seeded demo personas (demo only!)

# ── OpenRouter ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Per-role models. typesafe/jev-router picks the model + reasoning effort per request and bills at the
# serving model's price. Comma-separated fallbacks use OpenRouter routing (used if the router fails).
MODEL_FAST=typesafe/jev-router
MODEL_FAST_FALLBACKS=anthropic/claude-haiku-5.5,google/gemini-3.8-flash
MODEL_CODE=typesafe/jev-router
MODEL_CODE_FALLBACKS=anthropic/claude-sonnet-5.5,openai/gpt-5.4-mini
MODEL_SYNTH=typesafe/jev-router
MODEL_SYNTH_FALLBACKS=anthropic/claude-sonnet-5.5,google/gemini-3.8-flash

# Evaluation judge ensembles (jury)
EVAL_JUDGES=openai/gpt-5.4-mini,google/gemini-3.8-flash,anthropic/claude-haiku-5.5
ONLINE_EVAL_JUDGES=openai/gpt-5.4-mini,google/gemini-3.8-flash
ONLINE_EVAL_SAMPLE_RATE=0.05        # share of answered turns judged live; every thumbs-down is judged

# ── Embeddings ─────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openrouter   # openrouter | local (sentence-transformers) | hash (tests only)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# ── Caching ────────────────────────────────────────────────────────────
PROMPT_CACHE_ENABLED=true
LLM_EXACT_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.08

# ── Spend guards ───────────────────────────────────────────────────────
DAILY_TURN_LIMIT=150               # turns per member account per UTC day (0 = unlimited; admins exempt)
TURN_TIMEOUT_SECONDS=150           # wall clock for one agent turn

# ── Observability ──────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=    # e.g. http://jaeger:4318 with --profile observability
# Langfuse LLM tracing: on when both keys are set (Project settings → API keys).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # US region: https://us.cloud.langfuse.com
LANGFUSE_CAPTURE_IO=true        # false = metadata, usage and scores only (no prompts, answers or rows)
LANGFUSE_SAMPLE_RATE=1.0

# ── Frontend ───────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
